# /opt/interview/.env on the VM — chmod 600, never commit.
# Generate secrets on the VM:  openssl rand -hex 24

# Image tag to run; CI rewrites this line on every deploy
IMAGE_TAG=fofl

# MongoDB root account (compose builds MONGODB_URI from these)
MONGO_ROOT_USER=interview_root
MONGO_ROOT_PASSWORD=

# App secrets (see README "Biến môi trường")
JWT_SECRET=
STAFF_PASSWORD=
ADMIN_CLEAN_PASSWORD=

# Optional: config mounted from /opt/interview/config (uncomment the volume in compose.yml too)
# ORG_CONFIG=/app/config/org.config.json
