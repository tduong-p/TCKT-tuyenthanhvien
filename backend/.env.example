# MongoDB connection string (one database per unit)
MONGODB_URI=mongodb://127.0.0.1:27017/interview

# Random long string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Password every staff account logs in with (required in production)
STAFF_PASSWORD=

# Extra password asked for by the admin "Làm sạch dữ liệu" button
ADMIN_CLEAN_PASSWORD=

# Optional: use a config file / assets folder outside the repo
# ORG_CONFIG=/path/to/org.config.json
# ORG_ASSETS_DIR=/path/to/assets
